<%- include('partials/head') %>
<h1>My Borrowings</h1>
<div class="card table-wrap"><table>
  <thead><tr><th>Book Title</th><th>Author</th><th>Borrowed</th><th>Due</th><th>Returned</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% borrowings.forEach(b => { %>
    <tr><td><a href="/books/<%= b.book_id %>"><%= b.title %></a></td><td><%= b.author %></td><td><%= fmtDate(b.borrowed_at) %></td><td><%= fmtDate(b.due_at) %></td><td><%= fmtDate(b.returned_at) %></td>
      <td><span class="badge <%= {Borrowed:'info',Returned:'ok',Overdue:'err'}[b.status] %>"><%= b.status %></span></td>
      <td><% if (!b.returned_at) { %><form method="post" action="/borrowings/<%= b.id %>/return"><button class="btn sm outline">Return</button></form><% } %></td></tr>
  <% }) %>
  <% if (!borrowings.length) { %><tr><td colspan="7" class="muted">You haven't borrowed anything yet.</td></tr><% } %>
  </tbody></table></div>
<%- include('partials/foot') %>
