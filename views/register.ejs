<%- include('partials/head') %>
<div class="auth-card">
  <div class="brand dark"><span class="brand-icon">📖</span><span>Create student account</span></div>
  <form method="post" action="/register" class="form">
    <label>Full name<input name="name" required></label>
    <label>Student ID<input name="student_id" required></label>
    <label>Email<input type="email" name="email" required></label>
    <label>Password<input type="password" name="password" minlength="6" required></label>
    <label>Confirm password<input type="password" name="confirm_password" minlength="6" required></label>
    <label>Librarian access code <small class="muted">(only for library staff, leave empty if you are a student)</small><input name="librarian_code" autocomplete="off"></label>
    <button class="btn primary block">Register</button>
  </form>
  <p class="muted small">Already registered? <a href="/login">Log in</a></p>
</div>
<%- include('partials/foot') %>
